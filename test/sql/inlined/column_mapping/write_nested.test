# name: test/sql/inlined/column_mapping/write_nested.test
# description: INSERT into column-mapped tables with STRUCT, LIST and MAP columns writes physical names and field ids at every level
# group: [column_mapping]

require parquet

require delta

require json

# spark_nested_<mode>_mode, written by Spark: (id, s STRUCT(x2, y NOT NULL), l INT[], ls STRUCT(a)[],
# m MAP(VARCHAR, STRUCT(b))), with s.x renamed to s.x2 between its two inserts. Every struct field has
# a physical name and a field id; a list element and a map's key and value have neither, as Spark writes them.

foreach mode name id

# -----------------------------------------------------------------------------
# {mode} mode, appending to a table Spark wrote
#

statement ok
FROM copy_dir('data/inlined/column_mapping/spark_nested_{mode}_mode', '{TEMP_DIR}/nested_{mode}');

statement ok
ATTACH '{TEMP_DIR}/nested_{mode}' AS nested (TYPE delta);

statement ok
INSERT INTO nested VALUES (3, {'x2': 30, 'y': 'three'}, [4, 5], [{'a': 3}], MAP {'k3': {'b': 300}});

query IIIII
SELECT * FROM nested ORDER BY id;
----
1	{'x2': 10, 'y': one}	[1, 2]	[{'a': 1}]	{k1={'b': 100}}
2	{'x2': 20, 'y': two}	[3]	[{'a': 2}]	{k2={'b': 200}}
3	{'x2': 30, 'y': three}	[4, 5]	[{'a': 3}]	{k3={'b': 300}}

query II
SELECT s.x2, ls[1].a FROM nested WHERE m['k3'].b = 300;
----
30	3

# DuckDB's file has the same schema nodes as one of Spark's: name, field id and child count, each as often, both ways
query II
WITH duck AS (
    SELECT name, field_id, num_children FROM parquet_schema('{TEMP_DIR}/nested_{mode}/duckdb-*.parquet')
    WHERE name <> 'duckdb_schema'
), spark_files AS (
    SELECT * FROM parquet_schema('{TEMP_DIR}/nested_{mode}/*/part-*.parquet')
), spark AS (
    SELECT name, field_id, num_children FROM spark_files
    WHERE name <> 'spark_schema' AND file_name = (SELECT min(file_name) FROM spark_files)
)
SELECT (SELECT count(*) FROM (FROM duck EXCEPT ALL FROM spark)), (SELECT count(*) FROM (FROM spark EXCEPT ALL FROM duck));
----
0	0

query I
SELECT count(*) FROM parquet_schema('{TEMP_DIR}/nested_{mode}/duckdb-*.parquet') WHERE field_id IS NOT NULL;
----
9

# Statistics are keyed by physical name at every level of a struct
query II
WITH stats AS (
    SELECT json_extract_string(json, '$.add.stats') AS s
    FROM read_ndjson_objects('{TEMP_DIR}/nested_{mode}/_delta_log/00000000000000000004.json')
    WHERE json_extract(json, '$.add') IS NOT NULL
)
SELECT s LIKE '%"x2"%', s LIKE '%"col-%":{"col-%":30%' FROM stats;
----
false	true

# A NOT NULL struct field is enforced, and named by its logical path
statement error
INSERT INTO nested VALUES (4, {'x2': 40, 'y': NULL}, [], [], MAP {});
----
NOT NULL constraint failed: nested.s.y

statement ok
DETACH nested;

# -----------------------------------------------------------------------------
# {mode} mode, a table DuckDB creates
#

statement ok
ATTACH '{TEMP_DIR}/created_{mode}' AS created (TYPE delta);

statement ok
CREATE TABLE created.created (id INTEGER,
    s STRUCT(x INTEGER, inner_s STRUCT(z VARCHAR), sl INTEGER[], sm MAP(VARCHAR, INTEGER)), l INTEGER[],
    m MAP(VARCHAR, INTEGER[])) WITH ('delta.columnMapping.mode' = '{mode}');

statement ok
INSERT INTO created.created VALUES (1, {'x': 1, 'inner_s': {'z': 'a'}, 'sl': [5], 'sm': MAP {'q': 6}}, [1],
    MAP {'k': [1, 2]}), (2, NULL, NULL, NULL);

query IIII
SELECT * FROM created.created ORDER BY id;
----
1	{'x': 1, 'inner_s': {'z': a}, 'sl': [5], 'sm': {q=6}}	[1]	{k=[1, 2]}
2	NULL	NULL	NULL

# A list and a map inside a struct resolve too: in id mode their entries have no ids, on either side
query III
SELECT s.inner_s.z, s.sl[1], s.sm['q'] FROM created.created WHERE s.x = 1;
----
a	5	6

# No logical name reaches the file; field ids on the columns and every struct field, none on list elements or map
# entries
query II
SELECT count(*) FILTER (name IN ('s', 'x', 'inner_s', 'z', 'sl', 'sm', 'l', 'm')),
       count(*) FILTER (field_id IS NOT NULL)
FROM parquet_schema('{TEMP_DIR}/created_{mode}/duckdb-*.parquet');
----
0	9

statement ok
DETACH created;

endloop

# -----------------------------------------------------------------------------
# icebergCompatV3: the log assigns ids to list elements and map entries, and the file must carry them
#

statement ok
ATTACH '{TEMP_DIR}/nested_iceberg' AS iceberg (TYPE delta);

statement ok
CREATE TABLE iceberg.iceberg (id INTEGER, l INTEGER[], m MAP(VARCHAR, INTEGER[]))
WITH ('delta.enableIcebergCompatV3' = 'true');

statement ok
INSERT INTO iceberg.iceberg VALUES (1, [1, 2], MAP {'k': [3, 4]});

query III
SELECT * FROM iceberg.iceberg;
----
1	[1, 2]	{k=[3, 4]}

# Each id the log's delta.columnMapping.nested.ids assigns, by its path below the column, sits on that node of the
# file, the list inside the map's value included (parquet_schema keeps the file's schema order)
query I
SELECT list(regexp_replace(entry.key, '^[^.]*\.', '') || '=' || entry.value ORDER BY entry.value)
FROM read_ndjson_objects('{TEMP_DIR}/nested_iceberg/_delta_log/00000000000000000000.json'),
     unnest(json_extract(json_extract_string(json, '$.metaData.schemaString'), '$.fields[*]')) AS t(f),
     unnest(map_entries(json_transform(json_extract(f, '$.metadata."delta.columnMapping.nested.ids"'),
                                       '"MAP(VARCHAR, INTEGER)"'))) AS e(entry);
----
['element=4', 'key=5', 'value=6', 'value.element=7']

query I
SELECT list(name || '=' || field_id) FROM parquet_schema('{TEMP_DIR}/nested_iceberg/duckdb-*.parquet')
WHERE name IN ('element', 'key', 'value');
----
['element=4', 'key=5', 'value=6', 'element=7']

# -----------------------------------------------------------------------------
# icebergCompatV3 in id mode: containers inside containers resolve by those ids on read too
#

statement ok
ATTACH '{TEMP_DIR}/nested_iceberg_id' AS iceberg_id (TYPE delta);

statement ok
CREATE TABLE iceberg_id.iceberg_id (id INTEGER, m MAP(VARCHAR, INTEGER[]), ll INTEGER[][])
WITH ('delta.enableIcebergCompatV3' = 'true', 'delta.columnMapping.mode' = 'id');

statement ok
INSERT INTO iceberg_id.iceberg_id VALUES (1, MAP {'k': [3, 4]}, [[1], [2, 3]]);

query III
SELECT * FROM iceberg_id.iceberg_id;
----
1	{k=[3, 4]}	[[1], [2, 3]]

query II
SELECT m['k'][2], ll[2][2] FROM iceberg_id.iceberg_id;
----
4	3

# -----------------------------------------------------------------------------
# NOT NULL struct fields whose names hold a quote and a dot
#

foreach mode name id

statement ok
FROM copy_dir('data/inlined/column_mapping/spark_quoted_{mode}_mode', '{TEMP_DIR}/quoted_{mode}');

statement ok
ATTACH '{TEMP_DIR}/quoted_{mode}' AS quoted (TYPE delta);

statement ok
INSERT INTO quoted VALUES (2, {'a"b': 3, 'c.d': 4});

query II
SELECT id, s FROM quoted ORDER BY id;
----
1	{'a"b': 1, 'c.d': 2}
2	{'a"b': 3, 'c.d': 4}

statement error
INSERT INTO quoted VALUES (3, {'a"b': NULL, 'c.d': 5});
----
NOT NULL constraint failed: quoted.s.a"b

statement error
INSERT INTO quoted VALUES (3, {'a"b': 5, 'c.d': NULL});
----
NOT NULL constraint failed: quoted.s.c.d

statement ok
DETACH quoted;

endloop

# -----------------------------------------------------------------------------
# A field written as __duckdb_field_id is refused
#

# The parquet writer's field_ids option reserves that name for a nested column's own id, case-insensitively. Spark
# keeps an existing column's name as its physical name when it turns mapping on, so the name can reach a mapped log.
# The upper-case table spells it __DUCKDB_FIELD_ID.
foreach table name_mode id_mode upper_name_mode

statement ok
FROM copy_dir('data/inlined/column_mapping/reserved_physical_name_{table}', '{TEMP_DIR}/reserved_{table}');

statement ok
ATTACH '{TEMP_DIR}/reserved_{table}' AS reserved (TYPE delta);

statement error
INSERT INTO reserved VALUES ({'x': 7});
----
a name DuckDB's parquet writer reserves for field ids

query I
SELECT count(*) FROM glob('{TEMP_DIR}/reserved_{table}/**/*.parquet');
----
0

statement ok
DETACH reserved;

endloop

# -----------------------------------------------------------------------------
# A NOT NULL struct field whose name holds a quote, without column mapping
#

statement ok
FROM copy_dir('data/inlined/column_mapping/unmapped_quoted_not_null', '{TEMP_DIR}/unmapped_quoted');

statement ok
ATTACH '{TEMP_DIR}/unmapped_quoted' AS unmapped_quoted (TYPE delta);

statement ok
INSERT INTO unmapped_quoted VALUES (1, {'a"b': 1, 'c': NULL});

statement error
INSERT INTO unmapped_quoted VALUES (2, {'a"b': NULL, 'c': 1});
----
NOT NULL constraint failed: unmapped_quoted.s.a"b
