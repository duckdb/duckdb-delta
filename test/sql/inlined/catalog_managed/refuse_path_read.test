# name: test/sql/inlined/catalog_managed/refuse_path_read.test
# description: reading a catalog-managed table straight off storage must fail, not return stale rows
# group: [catalog_managed]
#
# The fixture enables inCommitTimestamp because kernel v0.26 made it a requirement of catalogManaged
# (FeatureRequirement::Enabled) -- without it the table is rejected as an invalid protocol before any
# of this is reached.

require parquet

require delta

# -----------------------------------------------------------------------------
# delta_scan of a catalog-managed table
#
# The kernel itself refuses to open the snapshot without max_catalog_version; what we check here is
# that the refusal reaches the user as something they can act on.
#

statement error
SELECT count(*) FROM delta_scan('data/inlined/catalog_managed/delta_lake');
----
catalog-managed

# The message must point at the fix, not just at the refusal
statement error
SELECT count(*) FROM delta_scan('data/inlined/catalog_managed/delta_lake');
----
TYPE unity_catalog

# -----------------------------------------------------------------------------
# Plain delta ATTACH of the same table
#

statement ok
ATTACH 'data/inlined/catalog_managed/delta_lake' AS cmt (TYPE delta);

statement error
SELECT count(*) FROM cmt;
----
catalog-managed

statement ok
DETACH cmt;

# -----------------------------------------------------------------------------
# The catalog's coordinates are not user-settable
#
# This is the part the kernel cannot defend: any max_catalog_version satisfies its check, so a
# user-supplied one buys back exactly the stale read it is supposed to prevent.
#

statement error
ATTACH 'data/inlined/catalog_managed/delta_lake' AS cmt (TYPE delta, max_catalog_version 0);
----
supplied by the catalog

statement error
ATTACH 'data/inlined/catalog_managed/delta_lake' AS cmt (TYPE delta, log_tail []);
----
supplied by the catalog

# Same for a plain (non catalog-managed) table: provenance is what matters, not the table
statement error
ATTACH 'data/inlined/simple_table/delta_lake' AS plain (TYPE delta, max_catalog_version 0);
----
supplied by the catalog

# delta_scan no longer takes a log_tail at all
statement error
SELECT count(*) FROM delta_scan('data/inlined/simple_table/delta_lake', log_tail = []);
----
log_tail

# -----------------------------------------------------------------------------
# The child attach unity_catalog performs is the one allowed source
#
# Nothing else in this repo covers that branch -- inverting the gate would break unity_catalog with delta's
# own suite still green. It also shows the gate's limit: child_catalog_mode is itself just an option, so it
# is a guard against the footgun, not against someone reaching into internals on purpose.
#

statement ok
ATTACH 'data/inlined/catalog_managed/delta_lake' AS uc_child (TYPE delta, child_catalog_mode true, max_catalog_version 0);

query I
SELECT count(*) FROM uc_child;
----
10

statement ok
DETACH uc_child;

# -----------------------------------------------------------------------------
# Control: tables that are not catalog-managed are unaffected
#

query I
SELECT count(*) FROM delta_scan('data/inlined/simple_table/delta_lake');
----
10

statement ok
ATTACH 'data/inlined/simple_table/delta_lake' AS plain (TYPE delta);

query I
SELECT count(*) FROM plain;
----
10
