# name: test/sql/inlined/unsupported_types.test
# description: a table with a column type DuckDB cannot read is refused, not read without that column
# group: [inlined]

require parquet

require delta

# -----------------------------------------------------------------------------
# Intervals
#
# Delta has two interval types and DuckDB has one, so neither maps as is.
#

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_year_month');
----
Column 'v' has the Delta type interval year to month, which DuckDB cannot read yet

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_day_time');
----
Column 'v' has the Delta type interval day to second, which DuckDB cannot read yet

# Nested: the refused field is named by its path. A list or a map of intervals used to abort the process at
# bind: the refused element left its container short of the required children.

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_in_list');
----
Column 'v.element' has the Delta type interval year to month, which DuckDB cannot read yet

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_in_map_value');
----
Column 'v.value' has the Delta type interval day to second, which DuckDB cannot read yet

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_in_map_key');
----
Column 'v.key' has the Delta type interval year to month, which DuckDB cannot read yet

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_in_list_of_lists');
----
Column 'v.element.element' has the Delta type interval day to second, which DuckDB cannot read yet

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/interval_in_list_of_structs');
----
Column 'v.element.gap' has the Delta type interval day to second, which DuckDB cannot read yet

# A refused struct field was refused before; its message now carries the path (was 'gap')

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/struct_interval');
----
Column 's.gap' has the Delta type interval day to second, which DuckDB cannot read yet

# The first refusal wins: of a map's key and value both refused, the key (visited first)

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/map_both_interval');
----
Column 'v.key' has the Delta type interval year to month, which DuckDB cannot read yet

# ... and of two refused columns, the first

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/two_refused');
----
Column 'a' has the Delta type interval year to month, which DuckDB cannot read yet

# The refusal also holds when the table is attached, and the session survives it

statement ok
ATTACH 'data/inlined/unsupported_types/interval_in_map_value' AS iv_map (TYPE delta);

statement error
SELECT * FROM iv_map;
----
Column 'v.value' has the Delta type interval day to second, which DuckDB cannot read yet

statement ok
DETACH iv_map;

query I
SELECT 42;
----
42

# -----------------------------------------------------------------------------
# Geospatial
#
# Kernel parses these types only when built with its `geo-type-in-dev` feature, which this build
# leaves off, so the refusal is kernel's. With the feature on, DuckDB's message names the column.
#

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/geometry');
----
Unsupported Delta table type: 'geometry(EPSG:4326)'

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/geography');
----
Unsupported Delta table type: 'geography(EPSG:4326, spherical)'

# -----------------------------------------------------------------------------
# User-defined types
#
# Spark stores a UDT as `{"type":"udt", "sqlType":..., "class":...}`. Kernel parses it only when built
# with its `udt-in-dev` feature, which this build leaves off, so the refusal is kernel's. With the
# feature on, DuckDB's message names the column, as for the intervals above.
#

statement error
SELECT * FROM delta_scan('data/inlined/unsupported_types/user_defined');
----
Unsupported Delta table type: 'udt'
