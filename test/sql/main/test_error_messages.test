# name: test/sql/main/test_error_messages.test
# description: Test that clean error messages are generated
# group: [main]

require parquet

require delta

require httpfs

statement error
FROM delta_scan('./doesnt_exist_and_never_will_exist_i_hope');
----
IO Error: DeltaKernel InvalidTableLocationError (28): Invalid table location: Path does not exist:

statement ok
ATTACH './doesnt_exist_and_never_will_exist_i_hope' AS s1 (TYPE delta);

# TODO: ATTACH should probe the location and fail here, rather than deferring to first use.
query IIIIII
SHOW ALL TABLES;
----

statement ok
DETACH s1;

statement ok
CREATE SECRET s1 (
    TYPE S3,
    ENDPOINT 'http://localhost:1337'
)

statement error
FROM delta_scan('s3://bucket/doesnt/exist/either');
----
IO Error: DeltaKernel ObjectStoreError (8): Error interacting with object store: Generic S3 error: Error performing GET

statement error
FROM delta_scan('duck://bucket/doesnt/exist/either');
----
IO Error: DeltaKernel ObjectStoreError (8): Error interacting with object store: Generic URL error: Unable to recognise URL

statement ok
ATTACH 's3://bucket/doesnt/exist/either' AS s1 (TYPE delta);

# Listing the catalog asks whether a table is there, and that listing fails before kernel is involved,
# so this is DuckDB's error about the endpoint rather than kernel's about the object store.
statement error
SHOW ALL TABLES;
----
<REGEX>:.*Could not connect to server.*bucket.localhost:1337.*

# -----------------------------------------------------------------------------
# Kernel error codes added in v0.30 print their name
#
# The name table is positional; a code past its end would print as EnumOutOfRange. TableAlreadyExistsAtPath
# is the last code kernel v0.30.1 defines, so it pins the whole table.

statement ok
ATTACH '{TEMP_DIR}/error_names_existing_table' AS existing (TYPE delta);

statement ok
CREATE TABLE existing.existing (i INTEGER);

statement error
CREATE TABLE existing.existing (i INTEGER);
----
DeltaKernel TableAlreadyExistsAtPath (54): Table already exists at path
