# name: test/sql/main/filter_pushdown_column_path.test
# description: a pushed-down filter names its column by path, so a dot in a column name is not a struct field
# group: [main]

require parquet

require delta

require notwindows

# Two files, one row each, so the plan shows whether the filter reached kernel's file skipping.

statement ok
ATTACH '{TEMP_DIR}/filter_pushdown_column_path' AS t (TYPE delta);

statement ok
CREATE TABLE t.t ("a.b" INTEGER, s STRUCT(b INTEGER));

statement ok
INSERT INTO t.t VALUES (1, {'b': 10});

statement ok
INSERT INTO t.t VALUES (2, {'b': 20});

# -----------------------------------------------------------------------------
# Top-level column with a dot in its name
#

query I
SELECT "a.b" FROM t.t WHERE "a.b" = 2;
----
2

query II
EXPLAIN ANALYZE SELECT "a.b" FROM t.t WHERE "a.b" = 2;
----
analyzed_plan	<REGEX>:.*Scanning Files: 1/2.*

# -----------------------------------------------------------------------------
# Struct field
#

query I
SELECT s.b FROM t.t WHERE s.b = 20;
----
20

query II
EXPLAIN ANALYZE SELECT s.b FROM t.t WHERE s.b = 20;
----
analyzed_plan	<REGEX>:.*Scanning Files: 1/2.*
