# name: test/sql/main/writing/create_table.test
# description: CREATE TABLE for delta tables
# group: [writing]

require parquet

require delta

require json

require notwindows

# -----------------------------------------------------------------------------
# Basic create
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_basic' AS basic (TYPE delta);

statement ok
CREATE TABLE basic.basic (i INTEGER, s VARCHAR);

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_basic/_delta_log/*.json');
----
1

# The new table is served from the catalog without re-attaching
query II
SELECT column_name, data_type FROM duckdb_columns() WHERE table_name = 'basic';
----
i	INTEGER
s	VARCHAR

query I
SELECT count(*) FROM basic.basic;
----
0

statement error
CREATE TABLE basic.basic (i INTEGER);
----
already exists

# -----------------------------------------------------------------------------
# Naming the destination
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_with_location' AS with_location (TYPE delta);

statement ok
CREATE TABLE with_location.with_location (i INTEGER)
WITH (location = '{TEMP_DIR}/delta_create_with_location');

query I
SELECT count(*) FROM with_location.with_location;
----
0

# `path` named the same option before `location` did, and never shipped
statement ok
ATTACH '{TEMP_DIR}/delta_create_with_path' AS with_path (TYPE delta);

statement error
CREATE TABLE with_path.with_path (i INTEGER) WITH (path = '{TEMP_DIR}/delta_create_with_path');
----
names the destination with 'location', not 'path'

statement ok
ATTACH '{TEMP_DIR}/delta_create_other_path' AS other_path (TYPE delta);

statement error
CREATE TABLE other_path.other_path (i INTEGER) WITH (location = '{TEMP_DIR}/somewhere_else');
----
can only create a table at the attached path

# A trailing slash names the same path -- the comparison is normalized
statement ok
ATTACH '{TEMP_DIR}/delta_create_norm' AS norm (TYPE delta);

statement ok
CREATE TABLE norm.norm (i INTEGER) WITH (location = '{TEMP_DIR}/delta_create_norm/');

query I
SELECT count(*) FROM norm.norm;
----
0

# The option is bound and evaluated, so an expression can name the path. It must not
# begin with a string literal: the option grammar prefers a literal over an expression,
# so `'a' || 'b'` stops parsing at the operator.
statement ok
ATTACH '{TEMP_DIR}/delta_create_expr' AS expr (TYPE delta);

statement ok
CREATE TABLE expr.expr (i INTEGER) WITH (location = concat('{TEMP_DIR}/delta_create', '_expr'));

query I
SELECT count(*) FROM expr.expr;
----
0

# A fresh attach, so the failure is the option and not a duplicate table
statement ok
ATTACH '{TEMP_DIR}/delta_create_null_opt' AS null_opt (TYPE delta);

statement error
CREATE TABLE null_opt.null_opt (i INTEGER) WITH (location = NULL);
----
NULL is not a valid value for Delta CREATE TABLE option 'location'

# -----------------------------------------------------------------------------
# CREATE conflict handling
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_conflict' AS conflict (TYPE delta);

statement ok
CREATE TABLE conflict.conflict (i INTEGER);

# IF NOT EXISTS on an existing table is a no-op, and must not write a second commit
statement ok
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER);

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_conflict/_delta_log/*.json');
----
1

statement error
CREATE OR REPLACE TABLE conflict.conflict (i INTEGER);
----
do not support CREATE OR REPLACE TABLE

# A bad option fails even where the table already makes the statement a no-op
statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER) WITH (location = NULL);
----
NULL is not a valid value for Delta CREATE TABLE option 'location'

# So does a refused column
statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER DEFAULT 7);
----
does not support DEFAULT values ('i')

# And so does every column type that DuckDB could not create and then write: the statement asks for a table
# DuckDB will not make, so it fails fast, whether or not the table is there
statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER, s STRUCT(u UUID));
----
Delta CREATE TABLE does not support column 's' of type STRUCT(u UUID) (it holds a UUID): Delta has no such type

statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER, s STRUCT(v VARIANT));
----
Delta CREATE TABLE does not support column 's' with a VARIANT nested in a STRUCT yet

statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER, m MAP(INTEGER[], INTEGER));
----
Delta CREATE TABLE does not support column 'm' of type MAP(INTEGER[], INTEGER): a MAP with a LIST key

statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER, s VARCHAR COLLATE NOCASE);
----
Column collations are not supported for Delta tables: Delta CREATE TABLE, column 's' holds a VARCHAR COLLATE NOCASE

statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (i INTEGER, s STRUCT(a INTEGER)) PARTITIONED BY (s);
----
Delta CREATE TABLE does not support partitioning on column 's' of type STRUCT(a INTEGER)

# A type Delta cannot store is named as such, not as a misplaced VARIANT
statement error
CREATE TABLE IF NOT EXISTS conflict.conflict (u UNION(a VARIANT, b INTEGER));
----
Delta CREATE TABLE does not support column 'u' of type UNION(a VARIANT, b INTEGER): Delta has no such type

# None of them wrote a commit
query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_conflict/_delta_log/*.json');
----
1

# IF NOT EXISTS on a fresh path still creates
statement ok
ATTACH '{TEMP_DIR}/delta_create_if_not_exists' AS ine (TYPE delta);

statement ok
CREATE TABLE IF NOT EXISTS ine.ine (i INTEGER);

query I
SELECT count(*) FROM ine.ine;
----
0

# -----------------------------------------------------------------------------
# Partition columns
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_partitioned' AS partitioned (TYPE delta);

statement ok
CREATE TABLE partitioned.partitioned (id INTEGER, part_col VARCHAR) PARTITIONED BY (part_col);

# Written to and read back: a partition column the writer disagreed with would still create cleanly
statement ok
INSERT INTO partitioned.partitioned VALUES (1, 'a'), (2, 'b');

query II
SELECT id, part_col FROM partitioned.partitioned ORDER BY id;
----
1	a
2	b

# One directory per partition value, as Delta lays them out
query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_partitioned/part_col=*/*.parquet');
----
2

# A partition key matches its column whatever its case, and takes the column's spelling
statement ok
ATTACH '{TEMP_DIR}/delta_create_partition_case' AS partition_case (TYPE delta);

statement error
CREATE TABLE partition_case.partition_case (id INTEGER, Part_Col VARCHAR) PARTITIONED BY (nope);
----
PARTITIONED BY names column 'nope', which the table does not have

statement ok
CREATE TABLE partition_case.partition_case (id INTEGER, Part_Col VARCHAR) PARTITIONED BY (PART_COL);

query I
SELECT metaData.partitionColumns
FROM read_json('{TEMP_DIR}/delta_create_partition_case/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
[Part_Col]

# Kernel requires at least one non-partition column
statement ok
ATTACH '{TEMP_DIR}/delta_create_all_partitioned' AS all_partitioned (TYPE delta);

statement error
CREATE TABLE all_partitioned.all_partitioned (part_col VARCHAR) PARTITIONED BY (part_col);
----
Table must have at least one non-partition column

# A partition column must have a primitive type. Refused before kernel sees it, so before a directory exists, and
# before IF NOT EXISTS (below)
statement ok
ATTACH '{TEMP_DIR}/delta_create_nested_partition' AS nested_partition (TYPE delta);

statement error
CREATE TABLE nested_partition.nested_partition (i INTEGER, s STRUCT(a INTEGER)) PARTITIONED BY (s);
----
Not implemented Error: Delta CREATE TABLE does not support partitioning on column 's' of type STRUCT(a INTEGER): a Delta partition column must have a primitive type

statement error
CREATE TABLE nested_partition.nested_partition (i INTEGER, l INTEGER[]) PARTITIONED BY (l);
----
partitioning on column 'l' of type INTEGER[]

statement error
CREATE TABLE nested_partition.nested_partition (i INTEGER, m MAP(VARCHAR, INTEGER)) PARTITIONED BY (m);
----
partitioning on column 'm' of type MAP(VARCHAR, INTEGER)

statement error
CREATE TABLE nested_partition.nested_partition (i INTEGER, v VARIANT) PARTITIONED BY (v);
----
partitioning on column 'v' of type VARIANT

statement error
COPY (SELECT 1) TO '{TEMP_DIR}/delta_create_nested_partition/probe.csv';
----
No such file or directory

# -----------------------------------------------------------------------------
# Table properties
#
# Any option that is not `path` is a Delta table property. Kernel decides what a key
# means, so these assertions only check that the key and value reach the commit.
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_props' AS props (TYPE delta);

statement ok
CREATE TABLE props.props (i INTEGER) WITH ('delta.appendOnly' = 'true');

query I
SELECT json_extract_string(metaData.configuration, '$."delta.appendOnly"')
FROM read_json('{TEMP_DIR}/delta_create_props/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
true

# A quoted key keeps its case, which Delta property names depend on
statement ok
ATTACH '{TEMP_DIR}/delta_create_props_case' AS props_case (TYPE delta);

statement ok
CREATE TABLE props_case.props_case (i INTEGER) WITH ('myApp.Mixed.Key' = 'Kept');

query I
SELECT json_extract_string(metaData.configuration, '$."myApp.Mixed.Key"')
FROM read_json('{TEMP_DIR}/delta_create_props_case/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
Kept

# An unquoted dotted key is also accepted, and keeps its case
statement ok
ATTACH '{TEMP_DIR}/delta_create_props_bare' AS props_bare (TYPE delta);

statement ok
CREATE TABLE props_bare.props_bare (i INTEGER) WITH (delta.appendOnly = 'true');

query I
SELECT json_extract_string(metaData.configuration, '$."delta.appendOnly"')
FROM read_json('{TEMP_DIR}/delta_create_props_bare/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
true

# Several properties in one statement, all committed
statement ok
ATTACH '{TEMP_DIR}/delta_create_props_many' AS props_many (TYPE delta);

statement ok
CREATE TABLE props_many.props_many (i INTEGER)
WITH ('delta.appendOnly' = 'true', 'myApp.a' = '1', 'myApp.b' = '2');

query III
SELECT json_extract_string(metaData.configuration, '$."delta.appendOnly"'),
       json_extract_string(metaData.configuration, '$."myApp.a"'),
       json_extract_string(metaData.configuration, '$."myApp.b"')
FROM read_json('{TEMP_DIR}/delta_create_props_many/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
true	1	2

# `path` is ours, so it must not be written as a property, and nothing else leaks in either
statement ok
ATTACH '{TEMP_DIR}/delta_create_path_and_prop' AS path_and_prop (TYPE delta);

statement ok
CREATE TABLE path_and_prop.path_and_prop (i INTEGER)
WITH (location = '{TEMP_DIR}/delta_create_path_and_prop', 'myApp.a' = '1');

query I
SELECT json_keys(metaData.configuration)
FROM read_json('{TEMP_DIR}/delta_create_path_and_prop/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
[myApp.a]

# A key outside delta.* is the user's own property, kept as given: in CREATE, CREATE TABLE AS and COPY TO alike
statement ok
ATTACH '{TEMP_DIR}/delta_create_props_owner' AS props_owner (TYPE delta);

statement ok
CREATE TABLE props_owner.props_owner (i INTEGER) WITH ('owner' = 'me');

query I
SELECT json_extract_string(metaData.configuration, '$.owner')
FROM read_json('{TEMP_DIR}/delta_create_props_owner/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
me

# A delta.* key must be one Delta has, spelled exactly: keys are case-sensitive
statement ok
ATTACH '{TEMP_DIR}/delta_create_props_bad' AS props_bad (TYPE delta);

statement error
CREATE TABLE props_bad.props_bad (i INTEGER) WITH ('delta.columnmapping.mode' = 'name');
----
Delta table property keys are case-sensitive: 'delta.columnmapping.mode' is spelled 'delta.columnMapping.mode'

statement error
CREATE TABLE props_bad.props_bad (i INTEGER) WITH ('delta.columnMapping.mod' = 'name');
----
unknown Delta table property 'delta.columnMapping.mod'

# A known key kernel does not let a create set is kernel's to refuse
statement error
CREATE TABLE props_bad.props_bad (i INTEGER) WITH ('delta.targetFileSize' = '1000');
----
Setting delta property 'delta.targetFileSize' is not supported during CREATE TABLE

# A property kernel knows turns its feature on, which is how a table gets its protocol
statement ok
ATTACH '{TEMP_DIR}/delta_create_dv' AS dv (TYPE delta);

statement ok
CREATE TABLE dv.dv (i INTEGER) WITH ('delta.enableDeletionVectors' = 'true');

query IIII
SELECT protocol.minReaderVersion, protocol.minWriterVersion,
       list_contains(protocol.readerFeatures, 'deletionVectors'),
       list_contains(protocol.writerFeatures, 'deletionVectors')
FROM read_json('{TEMP_DIR}/delta_create_dv/_delta_log/00000000000000000000.json')
WHERE protocol IS NOT NULL;
----
3	7	true	true

statement ok
INSERT INTO dv.dv VALUES (1);

query I
SELECT i FROM dv.dv;
----
1

# -----------------------------------------------------------------------------
# Column mapping
#
# Kernel maps every column of a table created with column mapping; the writer writes every
# shape of such a table, nested and partitioned ones included.
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_cm' AS cm (TYPE delta);

statement ok
CREATE TABLE cm.cm (i INTEGER, s VARCHAR) WITH ('delta.columnMapping.mode' = 'name');

query I
SELECT json_extract_string(metaData.configuration, '$."delta.columnMapping.mode"')
FROM read_json('{TEMP_DIR}/delta_create_cm/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
name

# Nested columns are mapped at every level, struct fields included
statement ok
ATTACH '{TEMP_DIR}/delta_create_cm_nested' AS cm_nested (TYPE delta);

statement ok
CREATE TABLE cm_nested.cm_nested (i INTEGER, s STRUCT(x INTEGER), l INTEGER[]) WITH ('delta.columnMapping.mode' = 'id');

query I
SELECT json_extract_string(metaData.schemaString, '$.fields[1].type.fields[0].metadata."delta.columnMapping.physicalName"')
    LIKE 'col-%'
FROM read_json('{TEMP_DIR}/delta_create_cm_nested/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
true

statement ok
ATTACH '{TEMP_DIR}/delta_create_cm_part' AS cm_part (TYPE delta);

statement ok
CREATE TABLE cm_part.cm_part (i INTEGER, p VARCHAR) PARTITIONED BY (p) WITH ('delta.columnMapping.mode' = 'name');

query II
SELECT metaData.partitionColumns, json_extract_string(metaData.configuration, '$."delta.columnMapping.mode"')
FROM read_json('{TEMP_DIR}/delta_create_cm_part/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
[p]	name

# Mode `none` maps nothing
statement ok
ATTACH '{TEMP_DIR}/delta_create_cm_none' AS cm_none (TYPE delta);

statement ok
CREATE TABLE cm_none.cm_none (i INTEGER, p VARCHAR) PARTITIONED BY (p) WITH ('delta.columnMapping.mode' = 'none');

query I
SELECT json_extract_string(metaData.schemaString, '$.fields[0].metadata')
FROM read_json('{TEMP_DIR}/delta_create_cm_none/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
{}

# The mode is matched exactly, as kernel matches it, so an unrecognized spelling is kernel's
# to reject rather than silently treated as a mapped table
statement ok
ATTACH '{TEMP_DIR}/delta_create_cm_case' AS cm_case (TYPE delta);

statement error
CREATE TABLE cm_case.cm_case (i INTEGER, s VARCHAR) WITH ('delta.columnMapping.mode' = 'Name');
----
Invalid column mapping mode

# `delta.enableIcebergCompatV3` requires column mapping, and kernel maps with `name` when no mode is
# named
statement ok
ATTACH '{TEMP_DIR}/delta_create_cm_iceberg' AS cm_iceberg (TYPE delta);

statement ok
CREATE TABLE cm_iceberg.cm_iceberg (i INTEGER, s VARCHAR) WITH ('delta.enableIcebergCompatV3' = 'true');

query I
SELECT json_extract_string(metaData.configuration, '$."delta.columnMapping.mode"')
FROM read_json('{TEMP_DIR}/delta_create_cm_iceberg/_delta_log/00000000000000000000.json')
WHERE metaData IS NOT NULL;
----
name

statement ok
INSERT INTO cm_iceberg.cm_iceberg VALUES (1, 'a');

query II
SELECT i, s FROM cm_iceberg.cm_iceberg;
----
1	a

# -----------------------------------------------------------------------------
# Unsupported for now
#

statement ok
ATTACH '{TEMP_DIR}/delta_create_unsupported' AS unsupported (TYPE delta);

statement error
CREATE TABLE unsupported.wrong_name (i INTEGER);
----
must use the attached name

statement error
CREATE TABLE unsupported.unsupported (i INTEGER NOT NULL);
----
does not support NOT NULL

# A default or a generation expression needs a writer feature we do not request, so the table would
# be created without it: refused rather than dropped
statement error
CREATE TABLE unsupported.unsupported (i INTEGER DEFAULT 7);
----
does not support DEFAULT values ('i')

statement error
CREATE TABLE unsupported.unsupported (i INTEGER, j INTEGER GENERATED ALWAYS AS (i * 2));
----
does not support generated columns ('j')

statement error
CREATE TABLE unsupported.unsupported (i INTEGER, j INTEGER AS (i * 2) VIRTUAL);
----
does not support generated columns ('j')

# Refused before anything is written
query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_unsupported/_delta_log/*.json');
----
0

# Refused before the kernel call, so before the table directory is made, with the hint CTAS gives
statement error
CREATE TABLE unsupported.unsupported (i UINTEGER);
----
does not support column 'i' of type UINTEGER: Delta has no such type. Declare the column as a type Delta can store

statement error
CREATE TABLE IF NOT EXISTS unsupported.unsupported (s STRUCT(u UUID));
----
does not support column 's' of type STRUCT(u UUID) (it holds a UUID): Delta has no such type

# A MAP with a LIST key is a non-nullable list in Delta, and INSERT refuses a table with one, so CREATE
# refuses it too (CREATE accepts only what INSERT can then write), at any depth
statement error
CREATE TABLE unsupported.unsupported (i INTEGER, m MAP(INTEGER[], INTEGER));
----
does not support column 'm' of type MAP(INTEGER[], INTEGER): a MAP with a LIST key is a non-nullable list in Delta, which INSERT cannot write yet

statement error
CREATE TABLE unsupported.unsupported (i INTEGER, s STRUCT(m MAP(VARCHAR, MAP(VARCHAR[], INTEGER))));
----
does not support column 's' of type STRUCT(m MAP(VARCHAR, MAP(VARCHAR[], INTEGER))): a MAP with a LIST key

statement error
CREATE TABLE IF NOT EXISTS unsupported.unsupported (i INTEGER, l MAP(INTEGER[], INTEGER)[]);
----
a MAP with a LIST key

# Delta has no collations: the table would compare case-sensitively, so CREATE refuses a collated column
statement error
CREATE TABLE unsupported.unsupported (i INTEGER, s VARCHAR COLLATE NOCASE);
----
Not implemented Error: Column collations are not supported for Delta tables: Delta CREATE TABLE, column 's' holds a VARCHAR COLLATE NOCASE. The collation survives casts and string functions: write the column from an uncollated source

query I
SELECT count(*) FROM glob('{TEMP_DIR}/delta_create_unsupported/**');
----
0

# glob lists no directories: writing a file into it shows the directory was never made
statement error
COPY (SELECT 1) TO '{TEMP_DIR}/delta_create_unsupported/probe.csv';
----
No such file or directory

statement error
CREATE TABLE unsupported.unsupported (i INTEGER) SORTED BY (i);
----
SORTED BY is not supported for tables in a delta catalog

# A list below a struct key, or as a map value, is nullable: INSERT writes those, so CREATE takes them
statement ok
ATTACH '{TEMP_DIR}/delta_create_map_list' AS map_list (TYPE delta);

statement ok
CREATE TABLE map_list.map_list (i INTEGER, k MAP(STRUCT(a INTEGER[]), INTEGER), v MAP(INTEGER, INTEGER[]));

statement ok
INSERT INTO map_list.map_list VALUES (1, MAP {{'a': [1, NULL]}: 2}, MAP {3: [4, NULL]});

query III
SELECT * FROM map_list.map_list;
----
1	{{'a': [1, NULL]}=2}	{3=[4, NULL]}

# -----------------------------------------------------------------------------
# data_change
#
# A schema-only version 0 adds no rows, so its commit passes data_change false. Kernel stamps the
# flag on add actions only, and this commit has none, so the create's log line is where it shows.
#

statement ok
CALL enable_logging(level = 'debug');

statement ok
ATTACH '{TEMP_DIR}/delta_create_data_change' AS data_change (TYPE delta);

statement ok
CREATE TABLE data_change.data_change (i INTEGER);

query I
SELECT message FROM duckdb_logs WHERE type = 'delta.CreateTable' AND message LIKE '%delta_create_data_change%';
----
<REGEX>:Created .*delta_create_data_change at version 0, adding 0 files with data_change false

statement ok
CALL disable_logging();
