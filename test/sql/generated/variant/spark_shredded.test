# name: test/sql/generated/variant/spark_shredded.test
# description: Spark-written shredded VARIANT (variantShredding-preview): partial shredding, mismatches, mixed files
# group: [variant]

require parquet

require delta

require icu

require json

require-env GENERATED_DATA_AVAILABLE

require-env VARIANT_DATA_AVAILABLE

statement ok
SET TimeZone='UTC';

# -----------------------------------------------------------------------------
# Files really are shredded, and the table carries the feature
#

query I
SELECT count(*) > 0 FROM parquet_schema('./data/generated/variant/spark_shredded_object/delta_lake/*.parquet') WHERE name = 'typed_value';
----
true

query I
SELECT list_contains(protocol.readerFeatures, 'variantShredding-preview')
FROM read_json('./data/generated/variant/spark_shredded_object/delta_lake/_delta_log/00000000000000000000.json')
WHERE protocol IS NOT NULL;
----
true

# -----------------------------------------------------------------------------
# Partially shredded object: schema {a int, b string, c {e int}}
#

statement ok
ATTACH './data/generated/variant/spark_shredded_object/delta_lake' AS obj (TYPE delta);

# 30: extra field in the residual; 31: `a` mismatches its int shredding; 32: `a` missing; 33: nested extra
# field `c.f`; 34: explicit nulls.
query IIIIII
SELECT id, v::VARCHAR, variant_typeof(v.a), v.a::VARCHAR, variant_typeof(v.c.e), v.c.f FROM obj WHERE id >= 30 ORDER BY id;
----
30	{'a': 2, 'b': y, 'z': true}	INT32	2	VARIANT_NULL	NULL
31	{'a': notint, 'b': w}	VARCHAR	notint	VARIANT_NULL	NULL
32	{'b': only b}	VARIANT_NULL	NULL	VARIANT_NULL	NULL
33	{'a': 3, 'c': {'e': 4, 'f': 5}}	INT32	3	INT32	5
34	{'a': NULL, 'b': NULL}	VARIANT_NULL	NULL	VARIANT_NULL	NULL

query I
SELECT list(id ORDER BY id) FROM obj WHERE try_cast(v.a AS INT) >= 2;
----
[30, 33]

query I
SELECT list(id ORDER BY id) FROM obj WHERE try_cast(v.a AS INT) IS NULL AND v.a IS NOT NULL;
----
[11, 31]

query I
SELECT list(id ORDER BY id) FROM obj WHERE v.z = true;
----
[30]

query I
SELECT list(n.x.a::VARCHAR ORDER BY id) FROM obj WHERE id >= 30;
----
[2, notint, NULL, 3, NULL]

# -----------------------------------------------------------------------------
# One typed_value per physical type; row 41 mismatches every field
#

statement ok
ATTACH './data/generated/variant/spark_shredded_typed_fields/delta_lake' AS typed (TYPE delta);

query IIIIIIIIIIIIIIII
SELECT id, v.i8, v.i16, v.i32, v.i64, v.f, v.d, v.dec4, v.dec9, v.dec18, v.s, v.bin, v.b, v.dt, v.ts, v.tsn
FROM typed ORDER BY id;
----
40	1	300	70000	5000000000	1.5	2.25	12.34	123456.789	12345678901234.5678	str	\xCA\xFE	true	2024-01-15	2024-01-15 10:30:00+00	2024-01-15 10:30:00
41	x	x	x	x	x	x	x	x	x	1	1	1	1	1	1
42	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
43	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL	NULL

query IIIIIIIIIIIIIII
SELECT variant_typeof(v.i8), variant_typeof(v.i16), variant_typeof(v.i32), variant_typeof(v.i64),
       variant_typeof(v.f), variant_typeof(v.d), variant_typeof(v.dec4), variant_typeof(v.dec9),
       variant_typeof(v.dec18), variant_typeof(v.s), variant_typeof(v.bin), variant_typeof(v.b),
       variant_typeof(v.dt), variant_typeof(v.ts), variant_typeof(v.tsn)
FROM typed WHERE id = 40;
----
INT8	INT16	INT32	INT64	FLOAT	DOUBLE	DECIMAL(4, 2)	DECIMAL(9, 3)	DECIMAL(18, 4)	VARCHAR	BLOB	BOOL_TRUE	DATE	TIMESTAMP_MICROS_TZ	TIMESTAMP_MICROS

query I
SELECT list(id ORDER BY id) FROM typed WHERE try_cast(v.dt AS DATE) = DATE '2024-01-15' AND try_cast(v.dec18 AS DECIMAL(18, 4)) > 1;
----
[40]

# -----------------------------------------------------------------------------
# Shredded array<int>: element mismatch and null element
#

statement ok
ATTACH './data/generated/variant/spark_shredded_array/delta_lake' AS arr (TYPE delta);

query IIIII
SELECT id, v::VARCHAR, variant_typeof(v), v[2]::VARCHAR, variant_typeof(v[1]) FROM arr WHERE id >= 50 ORDER BY id;
----
50	[1, 2, 3]	ARRAY(3)	2	INT32
51	[1, x, 3]	ARRAY(3)	x	INT32
52	[]	ARRAY(0)	NULL	VARIANT_NULL
53	[NULL, 2]	ARRAY(2)	2	VARIANT_NULL

# -----------------------------------------------------------------------------
# Files with different physical layouts for `v`: int-shredded, string-shredded, unshredded
#

query I
SELECT count(DISTINCT file_name) FROM parquet_schema('./data/generated/variant/spark_shredded_multi_schema/delta_lake/*.parquet');
----
3

query III
SELECT id, v::VARCHAR, variant_typeof(v.a) FROM delta_scan('./data/generated/variant/spark_shredded_multi_schema/delta_lake') ORDER BY id;
----
60	{'a': 1}	INT32
61	{'a': s}	VARCHAR
62	{'a': t}	VARCHAR
63	{'a': 2}	INT8
64	{'a': 3}	INT8
65	{'a': u}	VARCHAR

query I
SELECT list(id ORDER BY id) FROM delta_scan('./data/generated/variant/spark_shredded_multi_schema/delta_lake') WHERE try_cast(v.a AS INT) >= 1;
----
[60, 63, 64]

# -----------------------------------------------------------------------------
# Spark-inferred shredding over two commits, read through a checkpoint
#

query I
SELECT count(*) FROM glob('./data/generated/variant/spark_shredded_inferred/delta_lake/_delta_log/*.checkpoint.parquet');
----
1

query IIIIII
SELECT count(*), sum(v.n::INT), count(DISTINCT v.name::VARCHAR), sum(v.o.p::DECIMAL(18, 1)),
       count(*) FILTER (WHERE v.tags[1]::VARCHAR = 't0'), max(variant_typeof(v.o.p))
FROM delta_scan('./data/generated/variant/spark_shredded_inferred/delta_lake');
----
200	19900	200	20000.0	67	DECIMAL(18, 1)

query II
SELECT id, v::VARCHAR FROM delta_scan('./data/generated/variant/spark_shredded_inferred/delta_lake') WHERE v.name = 'n150';
----
150	{'n': 150, 'name': n150, 'o': {'p': 150.5}, 'tags': [t0, u]}

# -----------------------------------------------------------------------------
# Variant min/max in the add action's stats
#

query I
SELECT count(*) FROM read_json('./data/generated/variant/spark_shredded_variant_stats/delta_lake/_delta_log/*.json')
WHERE add IS NOT NULL AND json_extract_string(add.stats, '$.minValues.v') IS NOT NULL;
----
2

query II
SELECT id, v::VARCHAR FROM delta_scan('./data/generated/variant/spark_shredded_variant_stats/delta_lake') WHERE try_cast(v.a AS INT) > 3 ORDER BY id;
----
71	{'a': 5, 'b': y}
72	{'a': 10, 'b': z}

query I
SELECT list(id ORDER BY id) FROM delta_scan('./data/generated/variant/spark_shredded_variant_stats/delta_lake') WHERE id > 71;
----
[72]

# -----------------------------------------------------------------------------
# Deletion vector + column mapping (name mode, `v` renamed to `w`)
#

statement ok
ATTACH './data/generated/variant/spark_shredded_dv_colmap/delta_lake' AS dv (TYPE delta);

query II
SELECT id, w::VARCHAR FROM dv ORDER BY id;
----
80	{'a': 1, 'b': x}
82	{'a': 3, 'c': 1}

query III
SELECT id, w.a, w.c FROM dv WHERE try_cast(w.a AS INT) >= 2 ORDER BY id;
----
82	3	1
