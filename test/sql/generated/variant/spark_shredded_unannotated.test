# name: test/sql/generated/variant/spark_shredded_unannotated.test
# description: Shredded VARIANT in a bare struct, without the Parquet VARIANT logical type
# group: [variant]

require parquet

require delta

require-env GENERATED_DATA_AVAILABLE

# The Delta schema already says VARIANT; the parquet reader still rejects the file when it recognises the
# variant from the struct layout instead of the annotation. With delta loaded that layout check is always on,
# so even parquet_schema() fails on the file.
mode skip

query I
SELECT count(*) > 0 FROM parquet_schema('./data/generated/variant/spark_shredded_unannotated/delta_lake/*.parquet') WHERE name = 'typed_value';
----
true

query II
SELECT id, v::VARCHAR FROM delta_scan('./data/generated/variant/spark_shredded_unannotated/delta_lake') ORDER BY id;
----
90	{'a': 1, 'b': x}
91	{'a': s, 'c': 2}
92	7

query I
SELECT list(id ORDER BY id) FROM delta_scan('./data/generated/variant/spark_shredded_unannotated/delta_lake') WHERE v.a = 1;
----
[90]

mode unskip
